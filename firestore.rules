rules_version = '2';

// Règles de sécurité Firestore — relio-dev.
// Par défaut, tout est refusé (aucune règle ouverte, même temporairement —
// voir CLAUDE.md, section « RGPD et données sensibles »). Chaque collection
// obtient sa propre règle au fil du chantier back, dans l'ordre déjà acté :
// users, codes_invitation (Phase 1) → publications → agenda → messages →
// documents → notifications.
service cloud.firestore {
  match /databases/{database}/documents {
    // Document `users/{uid}` du demandeur. Chaque appel est facturé comme
    // une lecture, mais Firestore mutualise les get() identiques au sein
    // d'une même évaluation — donc appeler userDoc() trois fois dans une
    // règle ne coûte en principe qu'une lecture, et une requête de liste ne
    // le paie pas par document retourné. À MESURER, pas à supposer : voir
    // CLAUDE.md, section « Chantier Référentiel », protocole de relevé.
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // users/{uid} : Phase 1 du chantier Back. Chacun ne peut lire que son
    // propre document. Création réservée aux comptes famille — les comptes
    // pro restent créés manuellement via la console pendant le MVP.
    // L'usager revendiqué (`usagersIds[0]`) doit correspondre à un vrai
    // code d'invitation existant, pour le même établissement. Aucune
    // modification cliente après création (update/delete verrouillés).
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role == 'famille'
        && request.resource.data.usagersIds.size() == 1
        && exists(/databases/$(database)/documents/codes_invitation/$(request.resource.data.codeInvitationUtilise))
        && get(/databases/$(database)/documents/codes_invitation/$(request.resource.data.codeInvitationUtilise)).data.usagerId == request.resource.data.usagersIds[0]
        && get(/databases/$(database)/documents/codes_invitation/$(request.resource.data.codeInvitationUtilise)).data.etablissementId == request.resource.data.etablissementId;

      allow update, delete: if false;
    }

    // codes_invitation/{codeId} : Phase 1 du chantier Back. Un utilisateur
    // authentifié peut lire un code précis par son ID (vérification au
    // moment de l'inscription), mais jamais énumérer la collection —
    // empêche de découvrir des codes valides par balayage. Aucune écriture
    // depuis le client : les codes sont créés à la main via la console
    // pendant le MVP (voir CLAUDE.md, section « Architecture des données »).
    match /codes_invitation/{codeId} {
      allow get: if request.auth != null;
      allow list: if false;
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // Référentiel (chantier Référentiel / R2) : etablissements, unites,
    // usagers.
    //
    // ÉCRITURE CLIENTE INTERDITE PARTOUT (`allow write: if false`) : ces
    // collections se peuplent par le script de seed (`tools/seed/`, SDK
    // Admin, qui contourne ces règles), plus tard par Relio Admin.
    //
    // Piège évité ici : sur un compte famille, `unitesAcces` n'existe pas —
    // et sur un compte pro, `usagersIds` n'existe pas (forme réelle des
    // documents vérifiée en base). Or accéder à un champ absent produit une
    // ERREUR d'évaluation, pas `null` : la règle échouerait et refuserait
    // l'accès. Le `||` court-circuite sur `true`, mais pas sur une erreur à
    // gauche. D'où `.get('champ', [])` partout, jamais `userDoc().champ`.
    // ---------------------------------------------------------------------

    // Lisible par tout membre de l'établissement, quel que soit son rôle.
    match /etablissements/{etablissementId} {
      allow read: if request.auth != null
        && userDoc().etablissementId == etablissementId;
      allow write: if false;
    }

    // Un pro reste borné à ses `unitesAcces` (moindre privilège). Une
    // famille peut lire n'importe quelle unité de son établissement : le
    // libellé de l'unité de son enfant doit s'afficher dans son app, et
    // `unitesAcces` n'existe pas sur un compte famille. L'alternative —
    // dériver l'unité depuis les usagers de la famille — imposerait un
    // get() par usager dans la règle. Un nom d'unité n'est pas une donnée
    // sensible : simplicité contre un risque nul.
    match /unites/{uniteId} {
      allow read: if request.auth != null
        && (
          uniteId in userDoc().get('unitesAcces', [])
          || (
            userDoc().role == 'famille'
            && userDoc().etablissementId == resource.data.etablissementId
          )
        );
      allow write: if false;
    }

    // Un pro accède aux usagers des unités de son `unitesAcces` ; une
    // famille, aux usagers dont l'id figure dans son `usagersIds`.
    //
    // Rappel : pour une requête de liste, cette règle est évaluée document
    // par document retourné — elle ne filtre pas. Une requête ramenant un
    // seul document hors périmètre échoue en entier. C'est pour ça que
    // `ReferentielService` borne toujours ses requêtes côté client.
    match /usagers/{usagerId} {
      allow read: if request.auth != null
        && (
          resource.data.uniteId in userDoc().get('unitesAcces', [])
          || usagerId in userDoc().get('usagersIds', [])
        );
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // publications (chantier Publications / étape 1)
    //
    // Première collection de CONTENU ouverte en écriture au client. Tout ce
    // qui suit sera réutilisé tel quel par messages, documents et agenda —
    // une erreur ici se retrouve multipliée par quatre.
    // ---------------------------------------------------------------------

    // Périmètre de lecture du demandeur, en UNE seule liste.
    //
    // Le `let` n'est pas cosmétique : sans lui, `userDoc()` serait appelé
    // trois fois. Firestore plafonne les get() à 10 par lecture de document
    // et 20 par requête ; la documentation annonce une mutualisation des
    // get() identiques, mais CLAUDE.md a précisément inscrit ce point comme
    // « à mesurer, pas à supposer » — et il ne l'a jamais été. Si la
    // mutualisation n'avait pas lieu, une page de 15 publications coûterait
    // 45 get() et la requête entière échouerait. Le `let` supprime la
    // question au lieu d'en dépendre : un get(), garanti par construction.
    //
    // Un pro a `unitesAcces` et pas `usagersIds` ; une famille l'inverse.
    // D'où `.get(champ, défaut)` partout : un champ absent produit une
    // ERREUR d'évaluation, pas `null` (leçon de R2).
    //
    // La fusion des trois listes n'est sûre que parce que les ids sont
    // préfixés par type (`unite_`, `usager_`, `etab_`) et globalement
    // uniques — un id d'usager ne peut pas entrer en collision avec un id
    // d'unité. Décision VERROUILLÉE, voir CLAUDE.md, section « Architecture
    // des données ». Un id non préfixé introduit plus tard ferait fuir cette
    // règle sans qu'aucun test ne le signale.
    function accesLecture() {
      let u = userDoc();
      return u.get('unitesAcces', [])
              .concat(u.get('usagersIds', []))
              .concat([u.get('etablissementId', '')]);
    }

    // Champs qu'aucune mise à jour ne doit jamais pouvoir toucher. Ils
    // déterminent l'auteur et la visibilité : les rendre modifiables
    // permettrait de réattribuer une publication ou d'en élargir la portée
    // après coup.
    function champsModifiablesSeulement(champs) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(champs);
    }

    match /publications/{publicationId} {
      // Lecture bornée au périmètre du demandeur via `cibles`.
      //
      // Cette règle ne filtre PAS `masquee` : une publication masquée reste
      // lisible par les comptes de son périmètre. C'est la couche
      // d'affichage qui décide qui la voit. Une règle qui la masquerait
      // changerait le sens de « masquer » — l'auteur ne pourrait plus jamais
      // revoir sa propre publication retirée, ce qui contredit la décision
      // déjà prise (« l'auteur doit voir que sa publication a été masquée,
      // pas la voir disparaître »).
      allow read: if request.auth != null
        && resource.data.cibles.hasAny(accesLecture());

      // Création réservée aux pros. `auteurId` est cloué sur l'appelant :
      // sans ça, n'importe quel pro pourrait publier au nom d'un collègue.
      //
      // Une portée individuelle ou groupe doit viser une unité du périmètre
      // de l'auteur. Une portée établissement n'est soumise à AUCUNE
      // restriction d'auteur : `peutDiffuserEtablissement` ne concerne que
      // les documents et les messages, jamais le fil d'actu — décision
      // actée, voir CLAUDE.md, section « Permission diffusion
      // établissement ». Ne pas la réintroduire ici sans rouvrir cette
      // décision : le fil d'actu est du contenu de valorisation
      // institutionnelle, ouvert à tous les pros.
      //
      // Ce que cette règle NE vérifie PAS, en connaissance de cause : que
      // chaque usager de `usagersConcernes` appartienne bien à l'unité
      // visée. Le faire demanderait un get() par usager de la liste, coûteux
      // et plafonné. L'interface ne propose déjà que les usagers du
      // périmètre du pro ; borner l'unité (un seul get()) couvre l'essentiel
      // du risque. Résidu accepté pour le MVP — décision (b) du brief,
      // validée par Séb : un client modifié pourrait glisser un id d'usager
      // d'une autre unité du même établissement. À reconsidérer si un
      // incident réel le justifie.
      allow create: if request.auth != null
        && request.resource.data.auteurId == request.auth.uid
        && userDoc().get('role', '') == 'pro'
        && (
          request.resource.data.typePublication == 'etablissement'
          || request.resource.data.uniteId in userDoc().get('unitesAcces', [])
        );

      // Deux branches distinctes, jamais fusionnées — elles n'ouvrent pas
      // les mêmes champs aux mêmes personnes.
      //
      // 1. Éditer le texte : l'AUTEUR SEUL. Modérer, c'est retirer, jamais
      //    réécrire les mots de quelqu'un d'autre.
      // 2. Masquer : l'auteur OU un compte `peutModerer`. Motif : si
      //    l'auteur est absent, parti, ou s'il est lui-même le problème, il
      //    doit exister un recours pour retirer une photo publiée par
      //    erreur.
      //
      // Le `hasOnly` de chaque branche protège les champs immuables
      // (auteurId, auteurNom, dateCreation, typePublication,
      // usagersConcernes, uniteId, cibles, etablissementId) : aucune
      // combinaison de clés modifiées ne peut les atteindre.
      allow update: if request.auth != null
        && (
          (
            champsModifiablesSeulement(['texte', 'modifiee', 'dateModification'])
            && resource.data.auteurId == request.auth.uid
          )
          || (
            champsModifiablesSeulement(['masquee', 'dateMasquage', 'masqueePar', 'motifMasquage'])
            && (
              resource.data.auteurId == request.auth.uid
              || userDoc().get('peutModerer', false) == true
            )
          )
        );

      // Sans exception. Le masquage est la seule forme de retrait — voir
      // CLAUDE.md, « jamais de suppression physique ».
      allow delete: if false;
    }
  }
}
